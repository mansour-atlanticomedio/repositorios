# =============================================================================
# InvenioRDM - Variables de entorno
# =============================================================================
# 1. Copia:      cp .env.example .env
# 2. Edita:      EDITOR .env
# 3. Dev:        docker compose -f docker-compose.dev.yml --env-file .env up -d
#    Prod:       docker compose -f docker-compose.yml --env-file .env up -d
# =============================================================================

# --- Seguridad ---------------------------------------------------------------
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
INVENIO_SECRET_KEY=CHANGE_ME

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=hello-world
POSTGRES_PASSWORD=hello-world
POSTGRES_DB=hello-world

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=hello-world
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# --- OpenSearch --------------------------------------------------------------
OPENSEARCH_HEAP=1g
OPENSEARCH_MEM_LIMIT=2g

# --- SMTP Mail ---------------------------------------------------------------
INVENIO_MAIL_SUPPRESS_SEND=true
INVENIO_MAIL_SERVER=localhost
INVENIO_MAIL_PORT=25
INVENIO_MAIL_USE_TLS=false
INVENIO_MAIL_USERNAME=
INVENIO_MAIL_PASSWORD=
INVENIO_MAIL_DEFAULT_SENDER=info@hello-world.com
