# =============================================================================
# InvenioRDM - Variables de entorno
# =============================================================================
# 1. Copia este archivo:   cp .env.example .env
# 2. Edita los valores     $EDITOR .env
# 3. Levanta el stack      docker compose -f docker-compose.local.yml --env-file .env up -d
# =============================================================================

# --- App ---------------------------------------------------------------------
IMAGE_TAG=prod
APP_HOST_BIND=127.0.0.1
DOCKER_SERVICES_IP_BIND=127.0.0.1

# --- Produccion (frontend nginx) --------------------------------------------
FRONTEND_HTTP_BIND=0.0.0.0
FRONTEND_HTTPS_BIND=0.0.0.0

# --- Seguridad ---------------------------------------------------------------
# OBLIGATORIO en produccion. Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
INVENIO_SECRET_KEY=CHANGE_ME

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=hello-world
POSTGRES_PASSWORD=hello-world
POSTGRES_DB=hello-world

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis-password

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=hello-world
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# --- OpenSearch --------------------------------------------------------------
# Minimo 12 caracteres, con mayusculas, minusculas, numeros y simbolos
OPENSEARCH_INITIAL_ADMIN_PASSWORD=MyStr0ng#Pass2026
OPENSEARCH_HEAP=1g
OPENSEARCH_MEM_LIMIT=2g

# --- pgAdmin (solo dev) ------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=info@hello-world.com
PGADMIN_DEFAULT_PASSWORD=hello-world
